@@ -0,0 +1,70 @@
+package app.morphe.extension.boostforreddit.video;
+
+import app.morphe.extension.shared.Logger;
+
+/**
+ * Shared position store that lets the full-screen video viewer resume from where the
+ * inline feed player left off. Matching is keyed on the Reddit submission id so a position
+ * can never be applied to the wrong video.
+ *
+ * <p>All entry points are no-ops unless the "Resume video position" patch is selected
+ * ({@link #isPatchIncluded()} is rewritten to return true by the patch). Player objects are
+ * never touched here; the patch reads the id and {@code getCurrentPosition()} in bytecode and
+ * only hands this class primitives, so the extension needs no app types.
+ *
+ * <p>Flow: {@link #saveFeedPosition} fires whenever the inline feed player pauses or is
+ * released (which includes the moment a post is tapped open). The patch reads the id and the
+ * position together from the feed player's current holder, so the pending resume always matches
+ * the video that was actually playing, regardless of how the feed switched to it.
+ * {@link #feedToViewer} consumes the pending resume exactly once. Within a viewer session it is
+ * already spent, so the user's own seeks are left alone.
+ */
+public final class VideoResumePatch {
+    /** Ignore trivially small positions; resuming a video that barely started is pointless. */
+    private static final long MIN_RESUME_MS = 3000;
+
+    /** One-shot resume target, armed each time the feed player pauses/releases. */
+    private static volatile String pendingId;
+    private static volatile long pendingPositionMs = -1;
+
+    public static boolean isPatchIncluded() {
+        // Overridden by patch.
+        return false;
+    }
+
+    /**
+     * The inline feed player paused or was released while playing {@code submissionId}; arm a
+     * one-shot resume. Fires on every pause, so each tap that opens the viewer refreshes it.
+     */
+    public static void saveFeedPosition(String submissionId, long positionMs) {
+        if (!isPatchIncluded()) {
+            return;
+        }
+        if (submissionId != null && positionMs >= MIN_RESUME_MS) {
+            pendingId = submissionId;
+            pendingPositionMs = positionMs;
+            Logger.printDebug(() -> "saveFeedPosition id=" + submissionId + " pos=" + positionMs);
+        }
+    }
+
+    /**
+     * The full-screen viewer is about to seek to {@code currentMs}. If a resume is armed for
+     * this submission, consume it once and resume from there; otherwise leave the viewer's own
+     * position untouched.
+     */
+    public static long feedToViewer(String submissionId, long currentMs) {
+        if (!isPatchIncluded()) {
+            return currentMs;
+        }
+        if (submissionId != null && submissionId.equals(pendingId) && pendingPositionMs >= MIN_RESUME_MS) {
+            long resume = pendingPositionMs;
+            pendingId = null;
+            pendingPositionMs = -1;
+            Logger.printDebug(() -> "feedToViewer resume id=" + submissionId + " pos=" + resume);
+            return resume;
+        }
+        return currentMs;
+    }
+
+    private VideoResumePatch() {}
+}
