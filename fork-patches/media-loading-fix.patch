index 0000000..b4aeace
--- /dev/null
+++ b/extensions/boostforreddit/src/main/java/app/morphe/extension/boostforreddit/http/reddit/RedditBlockedEndpointsFallbackInterceptor.java
@@ -0,0 +1,453 @@
+package app.morphe.extension.boostforreddit.http.reddit;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.node.ArrayNode;
+import com.fasterxml.jackson.databind.node.JsonNodeFactory;
+import com.fasterxml.jackson.databind.node.ObjectNode;
+import com.fasterxml.jackson.databind.node.TextNode;
+
+import org.jetbrains.annotations.NotNull;
+
+import java.io.IOException;
+import java.lang.reflect.Field;
+import java.lang.reflect.Modifier;
+import java.net.URLDecoder;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.regex.Pattern;
+
+import app.morphe.extension.boostforreddit.http.HttpUtils;
+import app.morphe.extension.boostforreddit.utils.LoggingUtils;
+import okhttp3.FormBody;
+import okhttp3.HttpUrl;
+import okhttp3.Interceptor;
+import okhttp3.MediaType;
+import okhttp3.Request;
+import okhttp3.RequestBody;
+import okhttp3.Response;
+import okhttp3.ResponseBody;
+
+/**
+ * Reddit answers /api/morechildren, /api/info and /by_id with 403 for many third-party
+ * clients. When that happens, rebuild the answer from /comments/<post>, which still works.
+ *
+ * <p>More children are returned flattened in pre-order, as JRAW expects. Only subtrees whose
+ * root is a direct child of the row's parent are returned; ids that could not be loaded go
+ * back as a new "more" row.
+ */
+public class RedditBlockedEndpointsFallbackInterceptor implements Interceptor {
+    private static final Pattern REDDIT_HOST = Pattern.compile("(^|\\.)reddit\\.com$");
+    private static final Pattern MORE_CHILDREN_PATH = Pattern.compile("^/api/morechildren(\\.json)?/?$");
+    private static final Pattern INFO_PATH = Pattern.compile("^/api/info(\\.json)?/?$");
+    private static final Pattern BY_ID_PATH = Pattern.compile("^/by_id/([^/]+?)(\\.json)?/?$");
+
+    private static final int MAX_REQUESTS = 10;
+    private static final int MAX_POSTS = 25;
+
+    private static final JsonNodeFactory JSON = JsonNodeFactory.instance;
+
+    public static boolean isPatchIncluded() {
+        // Overridden by patch.
+        return false;
+    }
+
+    @NotNull
+    @Override
+    public Response intercept(@NotNull Chain chain) throws IOException {
+        Request request = chain.request();
+        if (!isPatchIncluded()) {
+            return chain.proceed(request);
+        }
+
+        HttpUrl url = request.url();
+        if (!REDDIT_HOST.matcher(url.host()).find()) {
+            return chain.proceed(request);
+        }
+
+        String path = url.encodedPath();
+        boolean moreChildren = MORE_CHILDREN_PATH.matcher(path).matches();
+        boolean postsById = INFO_PATH.matcher(path).matches() || BY_ID_PATH.matcher(path).matches();
+        if (!moreChildren && !postsById) {
+            return chain.proceed(request);
+        }
+
+        Response original = chain.proceed(request);
+        if (original.code() != 403) {
+            return original;
+        }
+
+        ResponseBody originalBody = original.body();
+        MediaType originalType = originalBody == null ? null : originalBody.contentType();
+        String originalText = originalBody == null ? "" : originalBody.string();
+        original.close();
+
+        try {
+            JsonNode rebuilt = moreChildren
+                    ? rebuildMoreChildren(chain, request)
+                    : rebuildPostsById(chain, request);
+            if (rebuilt != null) {
+                LoggingUtils.logInfo(true, () -> "Blocked endpoint fallback served " + path);
+                return HttpUtils.makeJsonResponse(request, rebuilt);
+            }
+        } catch (Exception e) {
+            LoggingUtils.logException(false, () -> "Blocked endpoint fallback failed for " + path, e);
+        }
+
+        return original.newBuilder()
+                .body(ResponseBody.create(originalText, originalType))
+                .build();
+    }
+
+    private JsonNode rebuildMoreChildren(Chain chain, Request request) throws IOException {
+        Map<String, String> args = readArguments(request);
+        String linkId = args.get("link_id");
+        String children = args.get("children");
+        if (linkId == null || !linkId.startsWith("t3_") || children == null || children.isEmpty()) {
+            return null;
+        }
+        String postId = linkId.substring(3);
+
+        List<String> requested = new ArrayList<>();
+        for (String id : children.split(",")) {
+            id = id.trim();
+            if (!id.isEmpty() && !requested.contains(id)) {
+                requested.add(id);
+            }
+        }
+        if (requested.isEmpty()) {
+            return null;
+        }
+
+        Map<String, String> query = new LinkedHashMap<>();
+        query.put("sort", args.getOrDefault("sort", "confidence"));
+        query.put("always_show_media", "1");
+        if ("true".equals(args.get("profile_img"))) {
+            query.put("profile_img", "true");
+        }
+
+        Harvest harvest = new Harvest(requested);
+        int requests = 0;
+
+        // The first comment's parent_id is the node the row hangs under.
+        JsonNode first = fetchThread(chain, request, postId, requested.get(0), query);
+        requests++;
+        if (first == null) {
+            return null;
+        }
+        harvest.collect(first);
+        harvest.missing.remove(requested.get(0));
+        String parent = harvest.parentOf.get(requested.get(0));
+        if (parent == null) {
+            return null;
+        }
+
+        if (parent.startsWith("t1_") && !harvest.missing.isEmpty()) {
+            JsonNode siblings = fetchThread(chain, request, postId, parent.substring(3), withLimit(query));
+            requests++;
+            if (siblings != null) {
+                harvest.collect(siblings);
+            }
+        }
+
+        while (!harvest.missing.isEmpty() && requests < MAX_REQUESTS) {
+            String id = harvest.missing.iterator().next();
+            JsonNode thread = fetchThread(chain, request, postId, id, query);
+            requests++;
+            if (thread == null) {
+                break;
+            }
+            harvest.collect(thread);
+            harvest.missing.remove(id);
+        }
+
+        ArrayNode things = JSON.arrayNode();
+        List<String> leftover = new ArrayList<>();
+        Set<String> emitted = new HashSet<>();
+        for (String id : requested) {
+            JsonNode comment = harvest.comments.get(id);
+            if (comment == null) {
+                if (harvest.missing.contains(id)) {
+                    leftover.add(id);
+                }
+                continue;
+            }
+            if (!parent.equals(comment.path("data").path("parent_id").asText())) {
+                continue;
+            }
+            flatten(comment, things, emitted);
+        }
+        for (String id : requested) {
+            if (!emitted.contains(id) && !leftover.contains(id) && harvest.comments.containsKey(id)
+                    && !harvest.comments.containsKey(stripPrefix(harvest.parentOf.get(id)))) {
+                leftover.add(id);
+            }
+        }
+
+        if (!leftover.isEmpty()) {
+            ObjectNode moreData = JSON.objectNode();
+            moreData.put("count", leftover.size());
+            moreData.put("name", "t1_" + leftover.get(0));
+            moreData.put("id", leftover.get(0));
+            moreData.put("parent_id", parent);
+            moreData.put("depth", 0);
+            ArrayNode ids = moreData.putArray("children");
+            for (String id : leftover) {
+                ids.add(id);
+            }
+            ObjectNode more = JSON.objectNode();
+            more.put("kind", "more");
+            more.set("data", moreData);
+            things.add(more);
+        }
+
+        if (things.size() == 0) {
+            return null;
+        }
+
+        ObjectNode data = JSON.objectNode();
+        data.set("things", things);
+        ObjectNode json = JSON.objectNode();
+        json.set("errors", JSON.arrayNode());
+        json.set("data", data);
+        ObjectNode root = JSON.objectNode();
+        root.set("json", json);
+        return root;
+    }
+
+    private static Map<String, String> withLimit(Map<String, String> query) {
+        Map<String, String> copy = new LinkedHashMap<>(query);
+        copy.put("limit", "500");
+        return copy;
+    }
+
+    private static String stripPrefix(String fullname) {
+        if (fullname == null) return "";
+        int index = fullname.indexOf('_');
+        return index < 0 ? fullname : fullname.substring(index + 1);
+    }
+
+    private static final class Harvest {
+        final Map<String, JsonNode> comments = new HashMap<>();
+        final Map<String, String> parentOf = new HashMap<>();
+        final Set<String> missing;
+
+        Harvest(List<String> requested) {
+            missing = new LinkedHashSet<>(requested);
+        }
+
+        void collect(JsonNode thread) {
+            if (thread == null || !thread.isArray() || thread.size() < 2) return;
+            walk(thread.get(1));
+        }
+
+        private void walk(JsonNode listing) {
+            JsonNode children = listing == null ? null : listing.path("data").get("children");
+            if (children == null || !children.isArray()) return;
+            for (JsonNode child : children) {
+                if (!"t1".equals(child.path("kind").asText())) continue;
+                JsonNode data = child.get("data");
+                if (data == null) continue;
+                String id = data.path("id").asText(null);
+                if (id == null) continue;
+                comments.putIfAbsent(id, child);
+                parentOf.putIfAbsent(id, data.path("parent_id").asText(null));
+                missing.remove(id);
+                JsonNode replies = data.get("replies");
+                if (replies != null && replies.isObject()) {
+                    walk(replies);
+                }
+            }
+        }
+    }
+
+    private static void flatten(JsonNode comment, ArrayNode out, Set<String> emitted) {
+        JsonNode data = comment.get("data");
+        String id = data.path("id").asText();
+        if (!emitted.add(id)) return;
+
+        ObjectNode flatData = data.deepCopy();
+        flatData.set("replies", new TextNode(""));
+        ObjectNode flat = JSON.objectNode();
+        flat.put("kind", "t1");
+        flat.set("data", flatData);
+        out.add(flat);
+
+        JsonNode replies = data.get("replies");
+        if (replies == null || !replies.isObject()) return;
+        JsonNode children = replies.path("data").get("children");
+        if (children == null || !children.isArray()) return;
+        List<JsonNode> mores = new ArrayList<>();
+        for (JsonNode child : children) {
+            String kind = child.path("kind").asText();
+            if ("t1".equals(kind)) {
+                flatten(child, out, emitted);
+            } else if ("more".equals(kind)) {
+                mores.add(child);
+            }
+        }
+        for (JsonNode more : mores) {
+            out.add(more);
+        }
+    }
+
+    private JsonNode rebuildPostsById(Chain chain, Request request) throws IOException {
+        HttpUrl url = request.url();
+        List<String> fullnames = new ArrayList<>();
+        java.util.regex.Matcher byId = BY_ID_PATH.matcher(url.encodedPath());
+        String ids = byId.matches() ? byId.group(1) : url.queryParameter("id");
+        if (ids == null) {
+            Map<String, String> args = readArguments(request);
+            ids = args.get("id");
+        }
+        if (ids == null) return null;
+        for (String name : URLDecoder.decode(ids, "UTF-8").split(",")) {
+            name = name.trim();
+            if (name.isEmpty()) continue;
+            if (!name.startsWith("t3_")) {
+                return null;
+            }
+            fullnames.add(name);
+        }
+        if (fullnames.isEmpty() || fullnames.size() > MAX_POSTS) {
+            return null;
+        }
+
+        Map<String, String> query = new LinkedHashMap<>();
+        query.put("limit", "1");
+        query.put("depth", "1");
+        query.put("always_show_media", "1");
+        String srDetail = url.queryParameter("sr_detail");
+        if (srDetail != null) query.put("sr_detail", srDetail);
+
+        ArrayNode posts = JSON.arrayNode();
+        for (String name : fullnames) {
+            JsonNode thread = fetchThread(chain, request, name.substring(3), null, query);
+            if (thread == null) {
+                return null;
+            }
+            JsonNode post = thread.path(0).path("data").path("children").path(0);
+            if (post.isObject()) {
+                posts.add(post);
+            }
+        }
+
+        ObjectNode data = JSON.objectNode();
+        data.put("modhash", "");
+        data.set("dist", JSON.numberNode(posts.size()));
+        data.set("children", posts);
+        data.set("after", JSON.nullNode());
+        data.set("before", JSON.nullNode());
+        ObjectNode listing = JSON.objectNode();
+        listing.put("kind", "Listing");
+        listing.set("data", data);
+        return listing;
+    }
+
+    private static JsonNode fetchThread(Chain chain, Request original, String postId, String focus,
+                                        Map<String, String> query) throws IOException {
+        HttpUrl.Builder url = original.url().newBuilder()
+                .encodedPath("/comments/" + postId)
+                .query(null);
+        if (focus != null) {
+            url.addQueryParameter("comment", focus);
+        }
+        for (Map.Entry<String, String> entry : query.entrySet()) {
+            url.addQueryParameter(entry.getKey(), entry.getValue());
+        }
+        String rawJson = original.url().queryParameter("raw_json");
+        if (rawJson != null) {
+            url.addQueryParameter("raw_json", rawJson);
+        }
+
+        Request request = original.newBuilder()
+                .url(url.build())
+                .get()
+                .removeHeader("Content-Type")
+                .removeHeader("Content-Length")
+                .build();
+
+        try (Response response = chain.proceed(request)) {
+            if (!response.isSuccessful() || response.body() == null) {
+                LoggingUtils.logInfo(false, () -> "Fallback request " + request.url().encodedPath()
+                        + " returned " + response.code());
+                return null;
+            }
+            String body = response.body().string();
+            if (body.isEmpty() || (body.charAt(0) != '[' && body.charAt(0) != '{')) {
+                return null;
+            }
+            return HttpUtils.getJsonFromString(body);
+        }
+    }
+
+    private static Map<String, String> readArguments(Request request) {
+        Map<String, String> args = new LinkedHashMap<>();
+        HttpUrl url = request.url();
+        for (String name : url.queryParameterNames()) {
+            args.put(name, url.queryParameter(name));
+        }
+
+        RequestBody body = request.body();
+        if (body == null) {
+            return args;
+        }
+        if (body instanceof FormBody) {
+            FormBody form = (FormBody) body;
+            for (int i = 0; i < form.size(); i++) {
+                args.put(form.name(i), form.value(i));
+            }
+            return args;
+        }
+
+        // okio is obfuscated in Boost, so read JRAW's wrapped form bytes instead of writeTo().
+        byte[] content = findBytes(body, 0, new HashSet<>());
+        if (content == null) {
+            return args;
+        }
+        String form = new String(content, StandardCharsets.UTF_8);
+        for (String pair : form.split("&")) {
+            int eq = pair.indexOf('=');
+            if (eq <= 0) continue;
+            try {
+                args.put(URLDecoder.decode(pair.substring(0, eq), "UTF-8"),
+                        URLDecoder.decode(pair.substring(eq + 1), "UTF-8"));
+            } catch (Exception ignored) {
+            }
+        }
+        return args;
+    }
+
+    private static byte[] findBytes(Object object, int depth, Set<Object> seen) {
+        if (object == null || depth > 3 || !seen.add(object)) return null;
+        for (Class<?> type = object.getClass(); type != null && type != Object.class; type = type.getSuperclass()) {
+            for (Field field : type.getDeclaredFields()) {
+                if (Modifier.isStatic(field.getModifiers()) || field.getType().isPrimitive()) continue;
+                try {
+                    field.setAccessible(true);
+                    Object value = field.get(object);
+                    if (value instanceof byte[]) {
+                        return (byte[]) value;
+                    }
+                    if (value instanceof String && ((String) value).contains("children=")) {
+                        return ((String) value).getBytes(StandardCharsets.UTF_8);
+                    }
+                    if (value != null && !(value instanceof String) && !(value instanceof Number)
+                            && !value.getClass().getName().startsWith("java.")) {
+                        byte[] nested = findBytes(value, depth + 1, seen);
+                        if (nested != null) return nested;
+                    }
+                } catch (Throwable ignored) {
+                }
+            }
+        }
+        return null;
+    }
+
+}
