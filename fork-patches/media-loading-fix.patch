@@ -0,0 +1,40 @@
+package app.morphe.extension.boostforreddit.http;
+
+import androidx.annotation.NonNull;
+
+import java.util.concurrent.TimeUnit;
+
+import app.morphe.extension.shared.Logger;
+import okhttp3.ConnectionPool;
+import okhttp3.OkHttpClient;
+
+/**
+ * Boost builds its central OkHttp client with {@code ConnectionPool(0, 1, NANOSECONDS)},
+ * which forbids idle connections entirely: every request pays a fresh TCP + TLS handshake,
+ * including media fetches, thumbnails, and the video player's requests. Restoring a standard
+ * pool lets OkHttp reuse connections; stale ones are retried automatically
+ * ({@code retryOnConnectionFailure} is on by default).
+ *
+ * <p>Only active when the "Reuse HTTP connections" patch is selected;
+ * {@link #isPatchIncluded()} is rewritten to return true by the patch.
+ */
+public class ReuseHttpConnectionsPatch {
+    private static final int MAX_IDLE_CONNECTIONS = 5;
+    private static final long KEEP_ALIVE_MINUTES = 5;
+
+    public static boolean isPatchIncluded() {
+        // Overridden by patch.
+        return false;
+    }
+
+    public static void configureBuilder(@NonNull OkHttpClient.Builder builder) {
+        if (!isPatchIncluded()) {
+            return;
+        }
+        builder.connectionPool(new ConnectionPool(
+                MAX_IDLE_CONNECTIONS, KEEP_ALIVE_MINUTES, TimeUnit.MINUTES));
+        Logger.printDebug(() -> "Restored shared connection pool on OkHttp builder");
+    }
+
+    private ReuseHttpConnectionsPatch() {}
+}
