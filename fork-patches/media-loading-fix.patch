+package app.morphe.patches.reddit.customclients.boostforreddit.video
+
+import app.morphe.patcher.Fingerprint
+
+// Boost's inline feed player is class `Lcom/rubenmayayo/reddit/ui/fragments/a;` (source
+// BoostPlayer.java). A second copy exists for profile video lists; the resume feature targets
+// the main feed only, so the fingerprints pin the exact feed class type.
+private const val BOOST_PLAYER = "Lcom/rubenmayayo/reddit/ui/fragments/a;"
+private const val MEDIA_VIDEO_ACTIVITY = "Lcom/rubenmayayo/reddit/ui/activities/MediaVideoActivity;"
+
+// BoostPlayer.A(): inline player pauses (viewer opening as an opaque activity).
+internal val boostPlayerPauseFingerprint = Fingerprint(
+    strings = listOf("Pause player"),
+    custom = { _, classDef -> classDef.type == BOOST_PLAYER },
+)
+
+// BoostPlayer.G(): inline player released; snapshot position before release.
+internal val boostPlayerReleaseFingerprint = Fingerprint(
+    strings = listOf("Release player"),
+    custom = { _, classDef -> classDef.type == BOOST_PLAYER },
+)
+
+// Anchors the MediaVideoActivity class (its player-init method logs "initializePlayer").
+// Used only to reach the class; the patch iterates its methods to find every seek-to-q site
+// (there are two: the media-build path and the resume path).
+internal val mediaVideoActivityFingerprint = Fingerprint(
+    strings = listOf("initializePlayer"),
+    custom = { _, classDef -> classDef.type == MEDIA_VIDEO_ACTIVITY },
+)
