+
+import java.io.IOException;
+
+import app.morphe.extension.boostforreddit.http.HttpUtils;
+import app.morphe.extension.shared.Logger;
+import okhttp3.Interceptor;
+import okhttp3.MediaType;
+import okhttp3.Request;
+import okhttp3.Response;
+import okhttp3.ResponseBody;
+
+/**
+ * The Redgifs API now lists a {@code silent} mp4 (no audio track) ahead of {@code hd} and
+ * {@code sd} in each gif's {@code urls}. Point it at the file with audio so Boost plays sound
+ * whichever entry it picks.
+ */
+public class RedgifsAudioUrlInterceptor implements Interceptor {
+
+    @NonNull
+    @Override
+    public Response intercept(@NonNull Chain chain) throws IOException {
+        Request request = chain.request();
+        Response response = chain.proceed(request);
+
+        if (!request.url().host().equals("api.redgifs.com")
+                || !request.url().encodedPath().startsWith("/v2/")
+                || !response.isSuccessful()) {
+            return response;
+        }
+        ResponseBody body = response.body();
+        MediaType type = body == null ? null : body.contentType();
+        if (type == null || !"json".equals(type.subtype())) {
+            return response;
+        }
+
+        String text = body.string();
+        try {
+            JsonNode json = HttpUtils.getJsonFromString(text);
+            if (fixUrls(json)) {
+                text = HttpUtils.getStringFromJson(json);
+            }
+        } catch (RuntimeException e) {
+            Logger.printException(() -> "Could not rewrite Redgifs urls", e);
+        }
+        return response.newBuilder().body(ResponseBody.create(text, type)).build();
+    }
+
+    static boolean fixUrls(JsonNode node) {
+        boolean changed = false;
+        if (node.isObject()) {
+            JsonNode urls = node.get("urls");
+            if (urls instanceof ObjectNode && urls.has("silent")
+                    && node.path("hasAudio").asBoolean(true)) {
+                JsonNode withAudio = urls.hasNonNull("hd") ? urls.get("hd") : urls.get("sd");
+                if (withAudio != null && withAudio.isTextual()) {
+                    ((ObjectNode) urls).set("silent", withAudio);
+                    changed = true;
+                }
+            }
+        }
+        for (JsonNode child : node) {
+            changed |= fixUrls(child);
+        }
+        return changed;
+    }
+}
