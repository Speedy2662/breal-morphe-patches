+import app.morphe.patches.reddit.customclients.boostforreddit.http.interceptHttpRequests
+import app.morphe.patches.reddit.customclients.boostforreddit.misc.extension.sharedExtensionPatch
+import app.morphe.util.returnEarly
+import com.android.tools.smali.dexlib2.AccessFlags
+import com.android.tools.smali.dexlib2.builder.MutableMethodImplementation
+import com.android.tools.smali.dexlib2.immutable.ImmutableMethod
+
+private const val EXTENSION = "Lapp/morphe/extension/boostforreddit/video/VideoResumePatch;"
+private const val BOOST_PLAYER = "Lcom/rubenmayayo/reddit/ui/fragments/a;"
+private const val MEDIA_VIDEO_ACTIVITY = "Lcom/rubenmayayo/reddit/ui/activities/MediaVideoActivity;"
+private const val PLAYER_FIELD = "$BOOST_PLAYER->a:Lcom/google/android/exoplayer2/k;"
+private const val HOLDER_FIELD =
+    "$BOOST_PLAYER->k:Lcom/rubenmayayo/reddit/ui/fragments/SubmissionRecyclerViewLinearCardsVideoFragment\$VideoAdapter\$VideoSubmissionViewHolder;"
+private const val HOLDER_GET_SUBMISSION =
+    "Lcom/rubenmayayo/reddit/ui/fragments/SubmissionRecyclerViewLinearCardsVideoFragment\$VideoAdapter\$VideoSubmissionViewHolder;->o1()Lcom/rubenmayayo/reddit/models/reddit/SubmissionModel;"
+private const val GET_POSITION = "Lcom/google/android/exoplayer2/w1;->getCurrentPosition()J"
+private const val SUBMISSION_FIELD =
+    "Lcom/rubenmayayo/reddit/ui/activities/MediaActivity;->g:Lcom/rubenmayayo/reddit/models/reddit/SubmissionModel;"
+private const val GET_ID = "Lcom/rubenmayayo/reddit/models/reddit/ThingModel;->getId()Ljava/lang/String;"
+private const val POSITION_FIELD = "$MEDIA_VIDEO_ACTIVITY->q:J"
+
+private const val SAVE_HELPER = "morpheSaveFeedPosition"
+private const val RESUME_HELPER = "morpheApplyResume"
+
+@Suppress("unused")
+val resumeVideoPosition = bytecodePatch(
+    name = "Resume video position",
+    description = "When you open a feed video full-screen, resume playback from where the inline " +
+        "preview was instead of restarting at the beginning. Experimental.",
+    default = false,
+) {
+    dependsOn(interceptHttpRequests, sharedExtensionPatch)
+    compatibleWith(*BoostCompatible)
+
+    execute {
+        // Enable the extension entry points only when this patch is selected.
+        Fingerprint(definingClass = EXTENSION, name = "isPatchIncluded").method.returnEarly(true)
+
+        // region Feed side: snapshot the playing submission id + position on pause/release.
+
+        // Self-guarded helper: read the current holder's submission id and the player's position
+        // (atomically, from whatever is actually playing) and arm the resume.
+        boostPlayerPauseFingerprint.classDef.methods.add(
+            ImmutableMethod(
+                BOOST_PLAYER, SAVE_HELPER, emptyList(), "V",
+                AccessFlags.PUBLIC.value, null, null, MutableMethodImplementation(4),
+            ).toMutable().apply {
+                addInstructionsWithLabels(
+                    0,
+                    """
+                    iget-object v0, p0, $HOLDER_FIELD
+                    if-eqz v0, :done
+                    invoke-virtual { v0 }, $HOLDER_GET_SUBMISSION
+                    move-result-object v0
+                    if-eqz v0, :done
+                    invoke-virtual { v0 }, $GET_ID
+                    move-result-object v0
+                    if-eqz v0, :done
+                    iget-object v1, p0, $PLAYER_FIELD
+                    if-eqz v1, :done
+                    invoke-interface { v1 }, $GET_POSITION
+                    move-result-wide v1
+                    invoke-static { v0, v1, v2 }, $EXTENSION->saveFeedPosition(Ljava/lang/String;J)V
+                    :done
+                    return-void
+                    """,
+                )
+            },
+        )
+
+        // Snapshot when the inline player pauses or is released.
+        boostPlayerPauseFingerprint.method.addInstructions(
+            0, "invoke-virtual { p0 }, $BOOST_PLAYER->$SAVE_HELPER()V",
+        )
+        boostPlayerReleaseFingerprint.method.addInstructions(
+            0, "invoke-virtual { p0 }, $BOOST_PLAYER->$SAVE_HELPER()V",
+        )
+
+        // endregion
+
+        // region Viewer side: before it seeks, ask the extension to resume from the feed position.
+
+        val viewerClass = mediaVideoActivityFingerprint.classDef
+        viewerClass.methods.add(
+            ImmutableMethod(
+                MEDIA_VIDEO_ACTIVITY, RESUME_HELPER, emptyList(), "V",
+                AccessFlags.PUBLIC.value, null, null, MutableMethodImplementation(4),
+            ).toMutable().apply {
+                addInstructionsWithLabels(
+                    0,
+                    """
+                    iget-object v0, p0, $SUBMISSION_FIELD
+                    if-eqz v0, :done
+                    invoke-virtual { v0 }, $GET_ID
+                    move-result-object v0
+                    iget-wide v1, p0, $POSITION_FIELD
+                    invoke-static { v0, v1, v2 }, $EXTENSION->feedToViewer(Ljava/lang/String;J)J
+                    move-result-wide v1
+                    iput-wide v1, p0, $POSITION_FIELD
+                    :done
+                    return-void
+                    """,
+                )
+            },
+        )
+
+        // Inject the resume call into every method that seeks the viewer player to q:J
+        // (the media-build path and the resume path). feedToViewer is one-shot, so whichever
+        // runs first resumes and the other is a no-op.
+        viewerClass.methods.filter { method ->
+            method.name != RESUME_HELPER &&
+                method.implementation?.instructions?.any {
+                    (it as? com.android.tools.smali.dexlib2.iface.instruction.ReferenceInstruction)
+                        ?.reference?.toString() == "Lcom/google/android/exoplayer2/w1;->K(J)V"
+                } == true &&
+                method.implementation?.instructions?.any {
+                    (it as? com.android.tools.smali.dexlib2.iface.instruction.ReferenceInstruction)
+                        ?.reference?.toString()?.endsWith("MediaVideoActivity;->q:J") == true
+                } == true
+        }.forEach { method ->
+            method.addInstructions(
+                0, "invoke-virtual { p0 }, $MEDIA_VIDEO_ACTIVITY->$RESUME_HELPER()V",
+            )
+        }
+
+        // endregion
+    }
+}
