diff --git a/extensions/boostforreddit/src/main/java/app/morphe/extension/boostforreddit/http/ReuseHttpConnectionsPatch.java b/extensions/boostforreddit/src/main/java/app/morphe/extension/boostforreddit/http/ReuseHttpConnectionsPatch.java
